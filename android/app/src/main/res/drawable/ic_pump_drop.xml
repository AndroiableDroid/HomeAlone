        android:name="ripple_mid"
        android:pathData="M24,12 C17.37,12 12,17.37 12,24 C12,30.63 17.37,36 24,36 C30.63,36 36,30.63 36,24 C36,17.37 30.63,12 24,12 Z"
        android:strokeColor="#B30EA5E9"
        android:strokeWidth="1.5"
        android:fillColor="#00000000" />

    <!-- Water drop body -->
    <path
        android:name="drop_body"
        android:pathData="M24,10 C24,10 14,22 14,28 C14,33.52 18.48,38 24,38 C29.52,38 34,33.52 34,28 C34,22 24,10 24,10 Z"
