    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Outer ripple ring 1 (large) -->
    <path
        android:name="ripple_outer"
        android:pathData="M24,8 C15.16,8 8,15.16 8,24 C8,32.84 15.16,40 24,40 C32.84,40 40,32.84 40,24 C40,15.16 32.84,8 24,8 Z"
